# 后端环境变量示例：复制本文件为 .env 后按需修改
# 复制命令（Windows PowerShell）：Copy-Item .env.example .env

# SQLite 数据库文件（位于项目根目录）
DB_DATABASE=database.sqlite

# 是否自动同步数据库表结构（开发 true；生产务必改为 false，改用 migration）
DB_SYNCHRONIZE=true

# 后端端口（默认 5001，避免与其它项目占用 5000 冲突）
BACKEND_PORT=5001

# OAuth 授权：后端对外的基地址（用于生成回调地址，需在各平台控制台登记为回调域名）
BACKEND_BASE_URL=http://localhost:5001

# OAuth 授权：前端地址（授权完成后跳回前端「平台配置」页）
FRONTEND_URL=http://localhost:5173

# 发布状态轮询：每轮间隔（毫秒），以及单条记录最多轮询次数（超时标记失败）
POLL_INTERVAL_MS=15000
POLL_MAX_ATTEMPTS=20

# JWT 鉴权：签名密钥与有效期（生产环境务必替换为随机强密钥）
JWT_SECRET=please-change-me-to-a-random-secret
JWT_EXPIRES_IN=6000s

# 对象存储（Instagram 发布需要，S3/OSS/COS 兼容端点；Facebook/油管/TikTok 无需配置）
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_URL_EXPIRES=172800

# 本项目的代理参数，由 start-backend-proxy.bat 读取（Node.js 24+）。
# 如需代理，将前两项设为实际代理地址，例如 http://127.0.0.1:7890。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
NODE_USE_ENV_PROXY=1
